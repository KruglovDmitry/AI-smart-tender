.env
*.pem
*.key

# Данные пользователя (тендеры/каталоги) — не коммитим содержимое,
# кроме примеров sample-*
data/tenders/**
!data/tenders/.gitkeep
!data/tenders/sample-*
data/catalogs/**
!data/catalogs/.gitkeep
!data/catalogs/sample-*
data/uploads/**
!data/uploads/.gitkeep
data/exports/**
!data/exports/.gitkeep

# Локальные логи / дебаг / state
data/_logs/
data/_state/
data/debug-*.json
data/vision_samples/
tools-server/data/

# Playwright / Chromium profile (тысячи файлов кэша)
.browser-profile/
**/browser-profile/
**/tender-browser-profile/

# Локальные артефакты
tmp-*.json
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
.DS_Store
Thumbs.db
*.pma
