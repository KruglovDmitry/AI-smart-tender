# Скопируйте в один из путей (первый найденный дополняет пустые переменные):
#   %LOCALAPPDATA%\AISmartTender\.env
#   рядом с start.exe
#   корень репо AI-smart-tender\.env  (dev)
#
# Позже ключи переедут в dashboard; пока читает Electron при старте.

# --- DOM-модель tender-agent ---
AGENT_LLM_BASE_URL=https://api.deepseek.com
AGENT_LLM_API_KEY=
AGENT_LLM_MODEL=deepseek-flash
# или:
# TENDER_AGENT_LLM_BASE_URL=
# TENDER_AGENT_LLM_API_KEY=
# TENDER_AGENT_LLM_MODEL=

# --- Vision (ai_vision): Qwen-VL + UI-TARS ---
TENDER_AGENT_VISION_ENABLED=false
AV_TARS_BASE_URL=http://10.127.0.41:8000/v1
AV_TARS_MODEL=ui-tars
AV_TARS_API_KEY=EMPTY
AV_PLANNER_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
AV_PLANNER_API_KEY=
AV_PLANNER_MODEL=qwen3-vl-plus
AV_EXTRACT_MODEL=qwen3.6-flash
