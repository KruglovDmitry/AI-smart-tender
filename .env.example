# Скопируйте в .env и заполните ключи:
#   copy .env.example .env

WEBUI_PORT=3000
OLLAMA_PORT=11434
WEBUI_SECRET_KEY=change-me-to-a-long-random-string
ENABLE_SIGNUP=true

OPENAI_API_BASE_URLS=
OPENAI_API_KEYS=

TOOLS_PORT=8000
DEFAULT_MAX_CHARS=120000
DEFAULT_MAX_FILES=30
FETCH_TIMEOUT_SEC=30

TOOL_SERVER_CONNECTIONS=[{"type":"openapi","url":"http://tools-server:8000","path":"openapi.json","spec_type":"url","auth_type":"none","key":"","config":{"enable":true},"info":{"id":"tender-tools","name":"Tender Tools","description":"Server docs, fetch URL, browser agent"}}]

# Playwright + platform agent
BROWSER_HEADLESS=true
BROWSER_MAX_STEPS=20
AGENT_DEBUG_LOGS=true

# Primary LLM (DeepSeek text tool-caller)
AGENT_LLM_BASE_URL=https://api.deepseek.com
AGENT_LLM_API_KEY=
AGENT_LLM_MODEL=deepseek-flash
AGENT_PRIMARY_MODEL=deepseek-flash

PLATFORM_MAX_STEPS=40
PLATFORM_MAX_NEW_TENDERS=3
