# OpenAI-совместимый чат. Без ключа агент проходит только страницы,
# которые разбираются правилами DOM, и останавливается на незнакомой вёрстке.
TENDER_AGENT_LLM_BASE_URL=https://api.deepseek.com
TENDER_AGENT_LLM_API_KEY=
TENDER_AGENT_LLM_MODEL=deepseek-flash

# Пустой список — любой публичный http(s)-хост. Через запятую: example.com,fabrikant.ru
TENDER_AGENT_ALLOWED_HOSTS=

TENDER_AGENT_HEADLESS=true
# Относительно корня репозитория, не текущей папки запуска.
TENDER_AGENT_DATA_DIR=data/tenders
TENDER_AGENT_MAX_ACTIONS=40
TENDER_AGENT_MAX_LLM_CALLS=12
TENDER_AGENT_MAX_RETRIES=2
TENDER_AGENT_TIMEOUT_SECONDS=120
TENDER_AGENT_MAX_PAGES=5
TENDER_AGENT_DEFAULT_LIMIT=5
