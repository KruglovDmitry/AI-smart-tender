# Скопируйте в .env и заполните ключи:
#   copy .env.example .env

WEBUI_PORT=3000
OLLAMA_PORT=11434
WEBUI_SECRET_KEY=change-me-to-a-long-random-string
ENABLE_SIGNUP=true

# --- Внешние модели (OpenAI-compatible) ---
# Несколько провайдеров: URL и ключи через ";" в том же порядке.
#
# DeepSeek: https://platform.deepseek.com/
# Qwen (DashScope): https://dashscope.console.aliyun.com/
#
# Пример только DeepSeek:
# OPENAI_API_BASE_URLS=https://api.deepseek.com/v1
# OPENAI_API_KEYS=sk-your-deepseek-key
#
# Пример DeepSeek + Qwen (облако):
# OPENAI_API_BASE_URLS=https://api.deepseek.com/v1;https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_API_KEYS=sk-deepseek-key;sk-qwen-dashscope-key

OPENAI_API_BASE_URLS=
OPENAI_API_KEYS=

# Локальный Qwen через Ollama не требует ключей —
# после запуска: docker exec -it tender-ollama ollama pull qwen2.5:7b

# --- Tool server (папка на сервере + просмотр ссылок) ---
TOOLS_PORT=8000
DEFAULT_MAX_CHARS=120000
DEFAULT_MAX_FILES=30
FETCH_TIMEOUT_SEC=30

# Global tools для Open WebUI (бэкенд ходит на tools-server внутри Docker-сети).
# После docker compose up зайди в Admin → Integrations → Tools → Save (если tools ещё не в чате),
# затем у модели включи Tools (см. README).
TOOL_SERVER_CONNECTIONS=[{"type":"openapi","url":"http://tools-server:8000","path":"openapi.json","spec_type":"url","auth_type":"none","key":"","config":{"enable":true},"info":{"id":"tender-tools","name":"Tender Tools","description":"Read server folders and browse URLs"}}]
