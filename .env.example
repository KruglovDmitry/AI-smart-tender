# Скопируйте в .env:
#   copy .env.example .env

# --- UI ---
WEBUI_PORT=3000
WEBUI_SECRET_KEY=change-me-to-a-long-random-string
ENABLE_SIGNUP=true

# Чат-модели обычно настраивают в Open WebUI → Admin → Connections.
# Эти переменные опциональны (можно оставить пустыми).
OPENAI_API_BASE_URLS=
OPENAI_API_KEYS=

# --- Tools / пути данных ---
TOOLS_PORT=8000
# Ссылки скачивания Excel в браузере пользователя
TOOLS_PUBLIC_BASE_URL=http://localhost:8000

# Корень данных контейнера (exports, uploads, _state, _logs, catalogs…)
DATA_HOST_PATH=./data
# Папка тендеров на ПК пользователя (Windows: C:/Users/Name/Tenders или ./data/tenders)
TENDERS_HOST_PATH=./data/tenders

# Образ tools-server на Docker Hub (после push замените на свой)
TOOLS_IMAGE=dim4098/ai-smart-tender-tools:1.3.0

TOOL_SERVER_CONNECTIONS=[{"type":"openapi","url":"http://tools-server:8000","path":"openapi.json","spec_type":"url","auth_type":"none","key":"","config":{"enable":true},"info":{"id":"tender-tools","name":"Tender Tools","description":"Server docs, fetch URL, platform agent, Excel"}}]

# --- Browser / platform agent ---
BROWSER_HEADLESS=true
BROWSER_AGENT_ENABLED=false
BROWSER_MAX_STEPS=20
AGENT_DEBUG_LOGS=true

# LLM именно для platform agent внутри tools-server
# (ключи чата в UI WebUI сюда НЕ подставляются автоматически)
AGENT_LLM_BASE_URL=https://api.deepseek.com
AGENT_LLM_API_KEY=
AGENT_LLM_MODEL=deepseek-flash
AGENT_PRIMARY_MODEL=deepseek-flash

PLATFORM_MAX_STEPS=180
PLATFORM_MAX_NEW_TENDERS=10
PLATFORM_MAX_FILES_PER_TENDER=10
