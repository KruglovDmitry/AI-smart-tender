{
  "name": "ai-smart-tender-desktop",
  "version": "1.1.0",
  "private": true,
  "description": "Electron shell: Open WebUI + tools + tender-agent + dashboard",
  "main": "main.js",
  "author": "AI Smart Tender",
  "scripts": {
    "start": "electron .",
    "dist": "node ./node_modules/electron-builder/cli.js --win dir"
  },
  "build": {
    "appId": "local.aismarttender.desktop",
    "productName": "start",
    "copyright": "AI Smart Tender",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "toolbar.html",
      "toolbar.js",
      "package.json"
    ],
    "extraResources": [
      {
        "filter": [
          "**/*"
        ],
        "from": "../dist/OpenWebUI",
        "to": "OpenWebUI"
      },
      {
        "filter": [
          "**/*"
        ],
        "from": "../dist/ToolsServer",
        "to": "ToolsServer"
      },
      {
        "filter": [
          "**/*"
        ],
        "from": "../dist/TenderAgent",
        "to": "TenderAgent"
      },
      {
        "filter": [
          "**/*"
        ],
        "from": "../dist/Dashboard",
        "to": "Dashboard"
      },
      {
        "to": "services.json",
        "from": "../services.json"
      }
    ],
    "win": {
      "target": [
        "dir"
      ],
      "signAndEditExecutable": false
    }
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  }
}
